import smtplib
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText

app = Flask(__name__)

FREE_LLM_URL = os.environ.get("FREE_LLM_URL", "http://localhost:3001/v1/messages")
UNIFIED_API_KEY = os.environ.get("UNIFIED_API_KEY", "freellmapi-your-unified-key")

SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
SENDER_EMAIL = os.environ.get("GMAIL_USER", "your_email@gmail.com")
SENDER_PASSWORD = os.environ.get("GMAIL_PASS", "your_app_password")
RECEIVER_EMAIL = os.environ.get("RECEIVER_EMAIL", SENDER_EMAIL)

market_state = {
    "price": 2650.00,
    "rsi": 50.0,
    "ai_reasoning": "Initializing FreeLLMAPI Smart Gateway...",
    "signal": "WAITING FOR AI CONFLUENCE",
    "badge_class": "badge-locked",
    "entry": "--", "tp": "--", "sl": "--"
}

price_history = [2650.0 + (i * 0.2) for i in range(30)]
last_signal_date = None

def ask_freellmapi_for_analysis(price, rsi, atr):
    headers = {
        "x-api-key": UNIFIED_API_KEY,
        "anthropic-version": "2023-06-01",
        "content-type": "application/json"
    }
    prompt = (
        f"Analyze XAUUSD current spot price at ${price}, RSI is {rsi:.1f}, and ATR is {atr}. "
        "As an institutional trading expert focusing on strict 1-signal/day high probability setups, "
        "evaluate if this meets absolute high win-rate confluence. "
        "Return a clear verdict containing 'BUY', 'SELL', or 'HOLD' with concise institutional reasoning."
    )
    payload = {
        "model": "auto:smart",
        "max_tokens": 300,
        "messages": [{"role": "user", "content": prompt}]
    }
    try:
        response = requests.post(FREE_LLM_URL, json=payload, headers=headers, timeout=12)
        if response.status_code == 200:
            return response.json()['content'][0]['text']
        else:
            return f"API Error: {response.text}"
    except Exception as e:
        return f"Connection Error: {e}"

def send_gmail_alert(subject, body):
    try:
        msg = MIMEMultipart()
        msg['From'] = SENDER_EMAIL
        msg['To'] = RECEIVER_EMAIL
        msg['Subject'] = subject
        msg.attach(MIMEText(body, 'plain'))
        server = smtplib.SMTP(SMTP_SERVER, SMTP_PORT)
        server.starttls()
        server.login(SENDER_EMAIL, SENDER_PASSWORD)
        server.sendmail(SENDER_EMAIL, RECEIVER_EMAIL, msg.as_string())
        server.quit()
        print("[+] Gmail Alert Sent Successfully!")
    except Exception as e:
        print(f"[-] Email failed: {e}")

def background_ai_scanner():
    global market_state, last_signal_date
    while True:
        current_date = datetime.now().strftime("%Y-%m-%d")
        current_price = price_history[-1] + ((random.random() - 0.49) * 3.5)
        price_history.append(round(current_price, 2))
        if len(price_history) > 50: price_history.pop(0)

        gains, losses = 0, 0
        for i in range(1, 15):
            diff = price_history[-i] - price_history[-i-1]
            if diff > 0: gains += diff
            else: losses -= diff
        rs = (gains / 14) / ((losses / 14) or 1)
        rsi = 100 - (100 / (1 + rs))
        atr = 5.8

        if last_signal_date == current_date:
            market_state.update({
                "price": round(current_price, 2), "rsi": round(rsi, 1),
                "signal": "DAILY QUOTA REACHED (1/1)",
                "ai_reasoning": "System locked for 24h after successful execution."
            })
        else:
            if rsi < 28 or rsi > 72:
                ai_analysis = ask_freellmapi_for_analysis(current_price, rsi, atr)
                market_state["ai_reasoning"] = ai_analysis

                if "BUY" in ai_analysis.upper() or rsi < 25:
                    entry = round(current_price, 2)
                    tp = round(entry + (atr * 4.0), 2)
                    sl = round(entry - (atr * 1.0), 2)
                    market_state.update({
                        "price": entry, "rsi": round(rsi, 1),
                        "signal": "🎯 AI APEX BUY SIGNAL (TP/SL Ready)",
                        "badge_class": "badge-active",
                        "entry": f"${entry}", "tp": f"${tp}", "sl": f"${sl}"
                    })
                    send_gmail_alert("🚨 AI APEX SIGNAL: XAUUSD BUY", f"Analysis:\n{ai_analysis}\n\nEntry: ${entry}\nTP: ${tp}\nSL: ${sl}")
                    last_signal_date = current_date
                elif "SELL" in ai_analysis.upper() or rsi > 75:
                    entry = round(current_price, 2)
                    tp = round(entry - (atr * 4.0), 2)
                    sl = round(entry + (atr * 1.0), 2)
                    market_state.update({
                        "price": entry, "rsi": round(rsi, 1),
                        "signal": "🎯 AI APEX SELL SIGNAL (TP/SL Ready)",
                        "badge_class": "badge-active",
                        "entry": f"${entry}", "tp": f"${tp}", "sl": f"${sl}"
                    })
                    send_gmail_alert("🚨 AI APEX SIGNAL: XAUUSD SELL", f"Analysis:\n{ai_analysis}\n\nEntry: ${entry}\nTP: ${tp}\nSL: ${sl}")
                    last_signal_date = current_date
            else:
                market_state.update({
                    "price": round(current_price, 2), "rsi": round(rsi, 1),
                    "signal": "⏳ FILTERING NOISE VIA FREELLMAPI",
                    "badge_class": "badge-locked"
                })
        time.sleep(45)

